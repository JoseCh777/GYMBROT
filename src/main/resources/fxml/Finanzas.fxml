<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" prefWidth="1440" style="-fx-background-color: #111316;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.FinanzasController">

    <!-- LEFT: SideNav -->
    <left>
        <VBox fx:id="sideNav" minWidth="256" prefWidth="256" style="-fx-background-color: #121417; -fx-border-color: #1f2125; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>

            <VBox spacing="2">
                <VBox.margin><Insets bottom="32" left="16" /></VBox.margin>
                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 28px; -fx-font-weight: 900; -fx-font-style: italic; -fx-text-fill: #D4FF00;" text="GYMBROT" />
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboard" maxWidth="Infinity" onAction="#handleNavDashboard" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Dashboard">
                    <graphic><ImageView fitHeight="20.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/dashboard_white.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navClientes" maxWidth="Infinity" onAction="#handleNavClientes" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Clientes">
                    <graphic><ImageView fitHeight="20.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/group_white.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navInstructores" maxWidth="Infinity" onAction="#handleNavInstructores" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Instructores">
                    <graphic><ImageView fitHeight="20.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/instructor_white.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navCitas" maxWidth="Infinity" onAction="#handleNavCitas" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Citas">
                    <graphic><ImageView fitHeight="20.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/calendario_white.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navMembresias" maxWidth="Infinity" onAction="#handleNavMembresias" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Membresias">
                    <graphic><ImageView fitHeight="20.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/membresias_white.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navFinanzas" maxWidth="Infinity" prefHeight="44" style="-fx-background-color: #D4FF00; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 700; -fx-text-fill: black; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Finanzas">
                    <graphic><ImageView fitHeight="20.0" fitWidth="21.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/crecimiento.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navProgreso" maxWidth="Infinity" onAction="#handleNavProgreso" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Progreso Fisico">
                    <graphic><ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/muscle_white.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="navAI" maxWidth="Infinity" onAction="#handleNavAI" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Gymbrot AI">
                    <graphic><ImageView fitHeight="20.0" fitWidth="28.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../images/bot_white.png" /></image></ImageView></graphic>
                </Button>
            </VBox>

            <Separator opacity="0.1">
                <VBox.margin><Insets bottom="8" top="16" /></VBox.margin>
            </Separator>

            <VBox spacing="8">
                <Button maxWidth="Infinity" onAction="#handleLogout" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500; -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Cerrar Sesion" />
            </VBox>
        </VBox>
    </left>

    <!-- TOP: TopBar -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="64.0" style="-fx-background-color: #1a1d21; -fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;">
            <padding><Insets left="32" right="32" /></padding>
            <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: white;" text="Finanzas" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
    </top>

    <!-- CENTER: Contenido -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #111316; -fx-background-color: #111316; -fx-border-width: 0;">
            <VBox spacing="32">
                <padding><Insets bottom="80" left="32" right="32" top="32" /></padding>

                <!-- SECCION 1: Tarjetas de métricas -->
                <HBox prefHeight="42.0" prefWidth="1105.0" spacing="20">
                    <VBox prefHeight="155.0" spacing="8" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="INGRESOS ESTE MES" />
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="lblIngresosMes" prefHeight="70.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 48px; -fx-font-weight: 800; -fx-text-fill: #D4FF00;" text="\$0" />
                        </HBox>
                    </VBox>

                    <VBox prefHeight="155.0" spacing="8" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="MIEMBROS ACTIVOS" />
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="lblMiembrosActivos" prefHeight="70.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 48px; -fx-font-weight: 800; -fx-text-fill: white;" text="0" />
                        </HBox>
                    </VBox>

                    <VBox prefHeight="155.0" spacing="8" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #bdf4ff; -fx-border-width: 0 0 0 4; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TOTAL INGRESOS" />
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="lblTotalIngresos" prefHeight="70.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 48px; -fx-font-weight: 800; -fx-text-fill: white;" text="\$0" />
                        </HBox>
                    </VBox>
                </HBox>

                <!-- SECCION 2: Gráficos (Ingresos por mes + Método de pago) -->
                <HBox prefHeight="434.0" prefWidth="1105.0" spacing="20">
                    <VBox minHeight="263.0" prefHeight="263.0" prefWidth="704.0" spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                        <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: white; -fx-border-color: transparent transparent transparent #D4FF00; -fx-border-width: 0 0 0 4; -fx-padding: 0 0 0 12;" text="Ingresos Mensuales" />
                        <Label style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Ultimos 12 meses" />
                        <BarChart fx:id="chartIngresosMes" animated="false" legendVisible="false" prefHeight="297.0" prefWidth="654.0" style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="#9ca3af" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" tickLabelFill="#9ca3af" /></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox minWidth="320" prefWidth="380" spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                        <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: white; -fx-border-color: transparent transparent transparent #D4FF00; -fx-border-width: 0 0 0 4; -fx-padding: 0 0 0 12;" text="Método de Pago" />
                        <Label style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Distribución de ingresos" />
                        <PieChart fx:id="chartMetodoPago" animated="false" labelsVisible="true" legendVisible="true" style="-fx-background-color: transparent;" />
                    </VBox>
                </HBox>

                <!-- SECCION 3: Ingresos por Plan (cards) -->
                <VBox spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                    <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                    <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: white; -fx-border-color: transparent transparent transparent #D4FF00; -fx-border-width: 0 0 0 4; -fx-padding: 0 0 0 12;" text="Ingresos por Plan" />
                    <HBox fx:id="contenedorIngresosPlan" spacing="20" />
                </VBox>

                <!-- SECCION 4: Nuevos clientes + Pagos vencidos -->
                <HBox prefHeight="450.0" prefWidth="1105.0" spacing="20">
                    <VBox spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                        <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: white; -fx-border-color: transparent transparent transparent #D4FF00; -fx-border-width: 0 0 0 4; -fx-padding: 0 0 0 12;" text="Nuevos Clientes por Mes" />
                        <Label style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Ultimos 12 meses" />
                        <BarChart fx:id="chartNuevosClientes" animated="false" legendVisible="false" style="-fx-background-color: transparent;">
                            <xAxis><CategoryAxis side="BOTTOM" tickLabelFill="#9ca3af" /></xAxis>
                            <yAxis><NumberAxis side="LEFT" tickLabelFill="#9ca3af" /></yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>
                        <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px; -fx-font-weight: 600; -fx-text-fill: white; -fx-border-color: transparent transparent transparent #D4FF00; -fx-border-width: 0 0 0 4; -fx-padding: 0 0 0 12;" text="Pagos Vencidos" />
                        <Label style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #6b7280;" text="Membresías con fecha de fin vencida" />
                        <TableView fx:id="tablaPagosVencidos" prefHeight="417.0" prefWidth="486.0" style="-fx-background-color: #1a1d21; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-table-cell-border-color: #1f2125; -fx-control-inner-background: #1a1d21; -fx-font-family: 'Inter'; -fx-font-size: 13px;">
                            <columns>
                                <TableColumn fx:id="colVencidoCliente" prefWidth="160" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="CLIENTE" />
                                <TableColumn fx:id="colVencidoPlan" prefWidth="120" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="PLAN" />
                                <TableColumn fx:id="colVencidoMonto" prefWidth="100" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="MONTO" />
                                <TableColumn fx:id="colVencidoMetodo" prefWidth="120" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="METODO" />
                                <TableColumn fx:id="colVencidoFecha" prefWidth="100" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="FECHA" />
                                <TableColumn fx:id="colVencidoEstado" prefWidth="100" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ESTADO" />
                            </columns>
                        </TableView>
                    </VBox>
                </HBox>

                <!-- SECCION 5: Historial de Pagos -->
                <VBox spacing="16">
                    <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 24px; -fx-font-weight: 600; -fx-font-style: italic; -fx-text-fill: white; -fx-border-color: transparent transparent transparent #D4FF00; -fx-border-width: 0 0 0 4; -fx-padding: 0 0 0 12;" text="Historial de Pagos" />

                    <TableView fx:id="tablaHistorialPagos" prefHeight="280" style="-fx-background-color: #1a1d21; -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-table-cell-border-color: #1f2125; -fx-control-inner-background: #1a1d21; -fx-font-family: 'Inter'; -fx-font-size: 13px;">
                        <columns>
                            <TableColumn fx:id="colHPCliente" prefWidth="200" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="CLIENTE" />
                            <TableColumn fx:id="colHPPlan" prefWidth="120" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="PLAN" />
                            <TableColumn fx:id="colHPMonto" prefWidth="100" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="MONTO" />
                            <TableColumn fx:id="colHPMetodo" prefWidth="140" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="METODO" />
                            <TableColumn fx:id="colHPFecha" prefWidth="120" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="FECHA" />
                            <TableColumn fx:id="colHPEstado" prefWidth="100" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ESTADO" />
                            <TableColumn fx:id="colHPReferencia" prefWidth="150" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="REFERENCIA" />
                        </columns>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
