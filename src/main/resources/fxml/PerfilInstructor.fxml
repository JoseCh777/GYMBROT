<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane style="-fx-background-color: rgba(12,14,17,0.95);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.PerfilInstructorController">

    <VBox maxHeight="688" maxWidth="800" style="-fx-background-color: rgba(26,29,33,0.75);                  -fx-background-radius: 24;                  -fx-border-color: rgba(255,255,255,0.05);                  -fx-border-width: 1;                  -fx-border-radius: 24;                  -fx-effect: dropshadow(gaussian, rgba(202,243,0,0.15), 28, 0, 0, 0);">

        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <VBox spacing="0">

                <!-- HEADER -->
                <VBox spacing="0" style="-fx-background-color: transparent;                              -fx-border-color: rgba(255,255,255,0.05);                              -fx-border-width: 0 0 1 0;">
                    <padding><Insets bottom="24" left="40" right="32" top="32" /></padding>

                    <HBox alignment="BOTTOM_LEFT" spacing="0">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label fx:id="lblNombreInstructor" style="-fx-font-family: 'Lexend'; -fx-font-size: 42px; -fx-font-weight: 800;                                           -fx-font-style: italic; -fx-text-fill: white;                                           -fx-letter-spacing: -0.02em;" text="Nombre del Instructor" />
                        </VBox>

                        <HBox alignment="BOTTOM_CENTER" spacing="12">
                            <Button fx:id="btnEditar" onAction="#handleEditar" style="-fx-background-color: #24282d; -fx-background-radius: 8;                                            -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                            -fx-font-weight: 700; -fx-text-fill: white;                                            -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1;                                            -fx-border-radius: 8; -fx-cursor: hand;                                            -fx-padding: 10 20 10 20;" text="Editar" />
                        </HBox>

                        <Button fx:id="btnCerrar" onAction="#handleCerrar" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 4 4 16;">
                            <graphic>
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 18px;                                               -fx-text-fill: #6b7280;" text="X" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- CONTENIDO -->
                <HBox spacing="24">
                    <padding><Insets bottom="32" left="40" right="32" top="32" /></padding>

                    <!-- SIDEBAR: Foto + datos basicos -->
                    <VBox alignment="CENTER" minWidth="240" prefWidth="260" spacing="20" style="-fx-background-color: rgba(255,255,255,0.04);                                  -fx-background-radius: 16;                                  -fx-border-color: rgba(255,255,255,0.05);                                  -fx-border-width: 1; -fx-border-radius: 16;">
                        <padding><Insets bottom="32" left="24" right="24" top="32" /></padding>

                        <StackPane maxWidth="160" prefHeight="160" prefWidth="160">
                            <StackPane prefHeight="160" prefWidth="160" style="-fx-background-color: #282a2d; -fx-background-radius: 80;                                               -fx-border-color: #D4FF00; -fx-border-width: 4;                                               -fx-border-radius: 80;                                               -fx-effect: dropshadow(gaussian, rgba(212,255,0,0.2), 20, 0, 0, 0);">
                                <ImageView fx:id="imgFotoPerfil" fitHeight="148" fitWidth="148" preserveRatio="false">
                                    <StackPane.margin><Insets bottom="6" left="6" right="6" top="6" /></StackPane.margin>
                                </ImageView>
                                <Label fx:id="lblInicialesAvatar" style="-fx-font-family: 'Lexend'; -fx-font-size: 52px;                                               -fx-font-weight: 800; -fx-text-fill: #333538;" text="?" />
                            </StackPane>
                        </StackPane>

                        <Label fx:id="lblEspecialidad" style="-fx-background-color: rgba(212,255,0,0.08);                                       -fx-background-radius: 20;                                       -fx-border-color: rgba(212,255,0,0.2); -fx-border-width: 1;                                       -fx-border-radius: 20;                                       -fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                       -fx-font-weight: 700; -fx-text-fill: #D4FF00;                                       -fx-padding: 4 14 4 14;" text="Especialidad" />

                        <Region maxWidth="Infinity" prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.08);" />

                        <VBox maxWidth="Infinity" spacing="16">
                            <HBox alignment="CENTER_LEFT">
                                <Label prefHeight="15.0" prefWidth="100.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="REGISTRADO" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblMiembroDesde" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 13px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="---" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <Label prefHeight="15.0" prefWidth="60.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ESTADO" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblEstadoInstructor" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="---" />
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- COLUMNA DERECHA: Datos -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS">

                        <VBox spacing="0" style="-fx-background-color: #1a1d21; -fx-background-radius: 16;                                      -fx-border-color: #1f2125; -fx-border-width: 1;                                      -fx-border-radius: 16;">
                            <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox.margin><Insets bottom="24" /></VBox.margin>
                                <Rectangle height="20" style="-fx-fill: #D4FF00;" width="4" />
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="CREDENCIALES DEL INSTRUCTOR" />
                            </HBox>

                            <HBox spacing="40">
                                <VBox spacing="20" HBox.hgrow="ALWAYS">
                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TIPO DE ID / NUMERO" />
                                        <Label fx:id="lblTipoDocumento" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="--- / ---" />
                                    </VBox>

                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="CORREO ELECTRONICO" />
                                        <Label fx:id="lblCorreo" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="---" />
                                    </VBox>
                                </VBox>

                                <VBox spacing="20" HBox.hgrow="ALWAYS">
                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TELEFONO" />
                                        <Label fx:id="lblTelefono" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="---" />
                                    </VBox>

                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="FECHA DE CONTRATACION" />
                                        <Label fx:id="lblFechaContratacion" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="---" />
                                    </VBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="0" style="-fx-background-color: #1a1d21; -fx-background-radius: 16;                                      -fx-border-color: #1f2125; -fx-border-width: 1;                                      -fx-border-radius: 16;">
                            <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox.margin><Insets bottom="16" /></VBox.margin>
                                <Rectangle height="20" style="-fx-fill: #D4FF00;" width="4" />
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="DISPONIBILIDAD / NOTAS" />
                            </HBox>

                            <Label fx:id="lblDisponibilidad" style="-fx-font-family: 'Inter'; -fx-font-size: 14px;                                       -fx-font-weight: 400; -fx-text-fill: #9ca3af;" text="No especificada" wrapText="true" />
                        </VBox>

                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>

    </VBox>

</StackPane>
