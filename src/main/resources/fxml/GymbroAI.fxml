<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="900" prefWidth="1440" style="-fx-background-color: #111316;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.GymbroAIController">

    <!-- ═══ LEFT: SideNav ═══ -->
    <left>
        <VBox fx:id="sideNav" minWidth="256" prefWidth="256" style="-fx-background-color: #121417; -fx-border-color: #1f2125; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>

            <VBox spacing="2">
                <VBox.margin><Insets bottom="32" left="16" /></VBox.margin>
                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 28px; -fx-font-weight: 900;                               -fx-font-style: italic; -fx-text-fill: #D4FF00;" text="GYMBROT" />
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboard" maxWidth="Infinity" onAction="#handleNavDashboard" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Dashboard">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/dashboard_white.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="navClientes" maxWidth="Infinity" onAction="#handleNavClientes" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Clientes">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/group_white.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="navInstructores" maxWidth="Infinity" onAction="#handleNavInstructores" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Instructores">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/instructor_white.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="navMembresias" maxWidth="Infinity" onAction="#handleNavMembresias" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Membresias">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/membresias_white.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
                <Button fx:id="navProgreso" maxWidth="Infinity" onAction="#handleNavProgreso" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Progreso Fisico">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/muscle_white.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
                <!-- ACTIVO: Gymbrot AI -->
                <Button fx:id="navAI" maxWidth="Infinity" prefHeight="44" style="-fx-background-color: #D4FF00; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 700;                                -fx-text-fill: black; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Gymbrot AI">
                    <graphic>
                        <ImageView fitHeight="20" fitWidth="21" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/bot.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
            </VBox>

            <Separator opacity="0.1">
                <VBox.margin><Insets bottom="8" top="16" /></VBox.margin>
            </Separator>

            <VBox spacing="8">
                <Button maxWidth="Infinity" onAction="#handleLogout" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Cerrar Sesion" />
            </VBox>
        </VBox>
    </left>

    <!-- ═══ TOP: TopBar ═══ -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="64" style="-fx-background-color: #1a1d21; -fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;">
            <padding><Insets left="32" right="32" /></padding>

            <!-- Título + estado -->
            <HBox alignment="CENTER_LEFT" spacing="12" HBox.hgrow="ALWAYS">
                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 18px; -fx-font-weight: 700;                               -fx-text-fill: white;" text="Gymbrot AI" />
            </HBox>
        </HBox>
    </top>

    <!-- ═══ CENTER: Área principal del chat ═══ -->
    <center>
        <VBox style="-fx-background-color: #111316;">

            <!-- ── Zona de mensajes (scroll) ── -->
            <!--
                fx:id="scrollChat"  →  el Controller llama scrollChat.setVvalue(1.0)
                                       después de agregar cada burbuja para bajar al final
                fx:id="vboxMensajes" →  aquí se agregan los nodos de burbuja dinámicamente:
                                        vboxMensajes.getChildren().add(burbuja)
            -->
            <ScrollPane fx:id="scrollChat" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #111316; -fx-background-color: #111316;                                -fx-border-width: 0; -fx-padding: 0;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">

                <VBox fx:id="vboxMensajes" fillWidth="true" spacing="16" style="-fx-background-color: #111316;">
                    <padding><Insets bottom="24" left="32" right="32" top="24" /></padding>

                    <!-- ── Mensaje de bienvenida (estático, siempre visible) ── -->
                    <HBox alignment="TOP_LEFT" spacing="12">
                        <!-- Avatar bot -->
                        <VBox alignment="TOP_CENTER">
                            <HBox alignment="CENTER" prefHeight="36" prefWidth="36" style="-fx-background-color: #1e2a00; -fx-background-radius: 18;                                          -fx-border-color: #D4FF00; -fx-border-width: 1;                                          -fx-border-radius: 18;">
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                               -fx-font-weight: 900; -fx-text-fill: #D4FF00;" text="G" />
                            </HBox>
                        </VBox>
                        <!-- Burbuja bot -->
                        <VBox maxWidth="700" spacing="6">
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                           -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="GYMBROT AI" />
                            <VBox style="-fx-background-color: #1a1d21;                                          -fx-background-radius: 0 12 12 12;                                          -fx-border-color: #ffffff0d; -fx-border-width: 1;                                          -fx-border-radius: 0 12 12 12;">
                                <padding><Insets bottom="14" left="16" right="16" top="14" /></padding>
                                <Label style="-fx-font-family: 'Inter'; -fx-font-size: 14px;                                               -fx-text-fill: #e2e2e6; -fx-line-spacing: 2;" text="Hola, soy Gymbrot AI. Estoy conectado y listo para ayudarte. Puedes preguntarme sobre rutinas, estadísticas de clientes, membresías o cualquier cosa relacionada con el gimnasio." wrapText="true" />
                            </VBox>
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                           -fx-text-fill: #4b5563;" text="Ahora" />
                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>

            <!-- ── Separador ── -->
            <Separator opacity="0.08" />

            <!-- ── Barra de entrada (input + enviar) ── -->
            <HBox alignment="CENTER" spacing="12" style="-fx-background-color: #121417;">
                <padding><Insets bottom="20" left="32" right="32" top="20" /></padding>

                <!--
                    fx:id="txtMensaje"  →  el Controller lee txtMensaje.getText()
                                           y luego txtMensaje.clear()
                    onAction="#handleEnviar" →  envía al presionar Enter
                -->
                <TextField fx:id="txtMensaje" onAction="#handleEnviar" promptText="Pregunta lo que quieras a Gymbrot AI..." style="-fx-background-color: #1e2023;                                   -fx-background-radius: 24;                                   -fx-border-color: #333538; -fx-border-width: 1;                                   -fx-border-radius: 24;                                   -fx-font-family: 'Inter'; -fx-font-size: 14px;                                   -fx-text-fill: white;                                   -fx-prompt-text-fill: #4b5563;                                   -fx-padding: 14 20 14 20;" HBox.hgrow="ALWAYS" />

                <!-- Botón enviar -->
                <Button fx:id="btnEnviar" onAction="#handleEnviar" prefHeight="48" prefWidth="48" style="-fx-background-color: #D4FF00; -fx-background-radius: 24; -fx-cursor: hand; -fx-font-family: 'Lexend'; -fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #111316;" text="↑" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
