<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!-- Overlay -->

<StackPane style="-fx-background-color: rgba(12,14,17,0.95);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.PerfilClienteController">

    <!-- Modal principal -->
    <VBox maxHeight="860" maxWidth="1000" style="-fx-background-color: rgba(26,29,33,0.75);                  -fx-background-radius: 24;                  -fx-border-color: rgba(255,255,255,0.05);                  -fx-border-width: 1;                  -fx-border-radius: 24;                  -fx-effect: dropshadow(gaussian, rgba(202,243,0,0.15), 28, 0, 0, 0);">

        <!-- ── SCROLL para todo el contenido ── -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <VBox spacing="0">

                <!-- ── HEADER ── -->
                <VBox spacing="0" style="-fx-background-color: transparent;                              -fx-border-color: rgba(255,255,255,0.05);                              -fx-border-width: 0 0 1 0;">
                    <padding><Insets bottom="24" left="40" right="32" top="32" /></padding>

                    <HBox alignment="BOTTOM_LEFT" spacing="0">

                        <!-- Verificacion + Nombre -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS">

                            <!-- Badge verificacion -->
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Rectangle arcHeight="12" arcWidth="12" height="12" style="-fx-fill: #D4FF00;" width="12" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="VERIFICACION EXITOSA" />
                            </HBox>

                            <!-- Nombre del cliente — se llena desde controller -->
                            <Label fx:id="lblNombreCliente" style="-fx-font-family: 'Lexend'; -fx-font-size: 42px; -fx-font-weight: 800;                                           -fx-font-style: italic; -fx-text-fill: white;                                           -fx-letter-spacing: -0.02em;" text="Nombre del Cliente" />
                        </VBox>

                        <!-- Botones de accion -->
                        <HBox alignment="BOTTOM_CENTER" spacing="12">
                            <Button fx:id="btnEditarPerfil" onAction="#handleEditarPerfil" style="-fx-background-color: #24282d; -fx-background-radius: 8;                                            -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                            -fx-font-weight: 700; -fx-text-fill: white;                                            -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1;                                            -fx-border-radius: 8; -fx-cursor: hand;                                            -fx-padding: 10 20 10 20;" text="Editar Perfil" />
                        </HBox>

                        <!-- Boton cerrar -->
                        <Button fx:id="btnCerrar" onAction="#handleCerrar" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 4 4 16;">
                            <graphic>
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 18px;                                               -fx-text-fill: #6b7280;" text="X" />
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>

                <!-- ── CONTENIDO PRINCIPAL ── -->
                <HBox spacing="24">
                    <padding><Insets bottom="32" left="40" right="32" top="32" /></padding>

                    <!-- ── SIDEBAR: Foto + datos basicos ── -->
                    <VBox alignment="CENTER" minWidth="240" prefWidth="260" spacing="20" style="-fx-background-color: rgba(255,255,255,0.04);                                  -fx-background-radius: 16;                                  -fx-border-color: rgba(255,255,255,0.05);                                  -fx-border-width: 1; -fx-border-radius: 16;">
                        <padding><Insets bottom="32" left="24" right="24" top="32" /></padding>

                        <!-- Avatar con borde amarillo -->
                        <StackPane maxWidth="160" prefHeight="160" prefWidth="160">
                            <StackPane prefHeight="160" prefWidth="160" style="-fx-background-color: #282a2d; -fx-background-radius: 80;                                               -fx-border-color: #D4FF00; -fx-border-width: 4;                                               -fx-border-radius: 80;                                               -fx-effect: dropshadow(gaussian, rgba(212,255,0,0.2), 20, 0, 0, 0);">
                                <ImageView fx:id="imgFotoPerfil" fitHeight="148" fitWidth="148" preserveRatio="false">
                                    <StackPane.margin><Insets bottom="6" left="6" right="6" top="6" /></StackPane.margin>
                                </ImageView>
                                <!-- Placeholder iniciales cuando no hay foto -->
                                <Label fx:id="lblInicialesAvatar" style="-fx-font-family: 'Lexend'; -fx-font-size: 52px;                                               -fx-font-weight: 800; -fx-text-fill: #333538;" text="?" />
                            </StackPane>
                        </StackPane>

                        <!-- Badge plan/membresia -->
                        <Label fx:id="lblPlanMembresia" style="-fx-background-color: rgba(212,255,0,0.08);                                       -fx-background-radius: 20;                                       -fx-border-color: rgba(212,255,0,0.2); -fx-border-width: 1;                                       -fx-border-radius: 20;                                       -fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                       -fx-font-weight: 700; -fx-text-fill: #D4FF00;                                       -fx-padding: 4 14 4 14;" text="Plan de Membresia" />

                        <!-- Separador -->
                        <Region maxWidth="Infinity" prefHeight="1" style="-fx-background-color: rgba(255,255,255,0.08);" />

                        <!-- Datos rapidos -->
                        <VBox maxWidth="Infinity" spacing="16">

                            <HBox alignment="CENTER_LEFT">
                                <Label prefHeight="15.0" prefWidth="109.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="MIEMBRO DESDE" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblMiembroDesde" prefHeight="19.0" prefWidth="37.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 13px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="---" />
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <Label prefHeight="15.0" prefWidth="68.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ESTADO" HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblEstadoCliente" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="---" />
                            </HBox>

                        </VBox>
                    </VBox>

                    <!-- ── COLUMNA DERECHA: KPIs + Datos + Tabla ── -->
                    <VBox spacing="16" HBox.hgrow="ALWAYS">

                        <!-- KPIs: 3 tarjetas -->
                        <HBox spacing="12">

                            <!-- Ingresos Totales -->
                            <VBox spacing="4" style="-fx-background-color: #1a1d21; -fx-background-radius: 16;                                          -fx-border-color: #D4FF00; -fx-border-width: 0 0 0 4;                                          -fx-border-radius: 16 0 0 16;" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="INGRESOS TOTALES" />
                                <Label fx:id="lblIngresosTotales" style="-fx-font-family: 'Lexend'; -fx-font-size: 36px;                                               -fx-font-weight: 700; -fx-text-fill: white;" text="0" />
                            </VBox>

                            <!-- Ultima visita -->
                            <VBox spacing="4" style="-fx-background-color: #1a1d21; -fx-background-radius: 16;                                          -fx-border-color: #1f2125; -fx-border-width: 1;                                          -fx-border-radius: 16;" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ULTIMA VISITA" />
                                <Label fx:id="lblUltimaVisita" style="-fx-font-family: 'Lexend'; -fx-font-size: 24px;                                               -fx-font-weight: 700; -fx-text-fill: white;" text="---" />
                                <Label fx:id="lblHoraVisita" style="-fx-font-family: 'Inter'; -fx-font-size: 12px;                                               -fx-text-fill: #6b7280;" text="--:-- --" />
                            </VBox>

                            <!-- Vencimiento -->
                            <VBox spacing="4" style="-fx-background-color: #1a1d21; -fx-background-radius: 16;                                          -fx-border-color: #1f2125; -fx-border-width: 1;                                          -fx-border-radius: 16;" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="VENCIMIENTO" />
                                <Label fx:id="lblVencimiento" style="-fx-font-family: 'Lexend'; -fx-font-size: 24px;                                               -fx-font-weight: 700; -fx-text-fill: white;" text="---" />
                            </VBox>

                        </HBox>

                        <!-- Credenciales del cliente -->
                        <VBox spacing="0" style="-fx-background-color: #1a1d21; -fx-background-radius: 16;                                      -fx-border-color: #1f2125; -fx-border-width: 1;                                      -fx-border-radius: 16;">
                            <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                            <!-- Titulo seccion -->
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox.margin><Insets bottom="24" /></VBox.margin>
                                <Rectangle height="20" style="-fx-fill: #D4FF00;" width="4" />
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="CREDENCIALES DEL CLIENTE" />
                            </HBox>

                            <!-- Grid de datos: 2 columnas -->
                            <HBox spacing="40">

                                <VBox spacing="20" HBox.hgrow="ALWAYS">

                                    <!-- Tipo / Numero de documento -->
                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TIPO DE ID / NUMERO" />
                                        <Label fx:id="lblTipoDocumento" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="--- / ---" />
                                    </VBox>

                                    <!-- Correo -->
                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="CORREO ELECTRONICO" />
                                        <Label fx:id="lblCorreo" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="---" />
                                    </VBox>

                                </VBox>

                                <VBox spacing="20" HBox.hgrow="ALWAYS">

                                    <!-- Telefono -->
                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TELEFONO" />
                                        <Label fx:id="lblTelefono" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                       -fx-font-weight: 500; -fx-text-fill: white;" text="---" />
                                    </VBox>

                                    <!-- Categoria de edad -->
                                    <VBox spacing="4">
                                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="CATEGORIA DE EDAD" />
                                        <HBox alignment="CENTER_LEFT" spacing="8">
                                            <Label fx:id="lblCategoriaEdad" style="-fx-font-family: 'Inter'; -fx-font-size: 15px;                                                           -fx-font-weight: 500; -fx-text-fill: white;" text="---" />
                                            <Label fx:id="lblRangoEdad" style="-fx-background-color: rgba(255,255,255,0.05);                                                           -fx-background-radius: 4;                                                           -fx-border-color: rgba(255,255,255,0.1);                                                           -fx-border-width: 1; -fx-border-radius: 4;                                                           -fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                           -fx-text-fill: #6b7280; -fx-padding: 2 6 2 6;" text="" />
                                        </HBox>
                                    </VBox>

                                </VBox>

                            </HBox>
                        </VBox>

                        <!-- Registro de Ingresos y Egresos -->
                        <VBox spacing="0">

                            <!-- Titulo -->
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox.margin><Insets bottom="12" /></VBox.margin>
                                <Rectangle height="20" style="-fx-fill: #D4FF00;" width="4" />
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="REGISTRO DE INGRESO Y EGRESO" />
                            </HBox>

                            <!-- Tabla de accesos -->
                            <!-- Columnas: FECHA / HORA ENTRADA / PUNTO ACCESO / DURACION / ESTADO -->
                            <!-- Datos: REGISTROS_INGRESOS WHERE id_cliente = ? ORDER BY fecha DESC FETCH FIRST 10 -->
                            <TableView fx:id="tablaAccesos" prefHeight="220" style="-fx-background-color: rgba(255,255,255,0.04);                                               -fx-background-radius: 16;                                               -fx-border-color: rgba(255,255,255,0.08);                                               -fx-border-width: 1; -fx-border-radius: 16;                                               -fx-control-inner-background: transparent;                                               -fx-table-cell-border-color: rgba(255,255,255,0.04);                                               -fx-font-family: 'Inter'; -fx-font-size: 13px;">
                                <columns>
                                    <TableColumn fx:id="colFecha" prefWidth="130" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                         -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="FECHA" />
                                    <TableColumn fx:id="colHoraEntrada" prefWidth="150" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                         -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="HORA DE ENTRADA" />
                                    <TableColumn fx:id="colPuntoAcceso" prefWidth="180" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                         -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="PUNTO DE ACCESO" />
                                    <TableColumn fx:id="colDuracion" prefWidth="130" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                         -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="DURACION" />
                                    <TableColumn fx:id="colEstadoAcceso" prefWidth="120" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                                         -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ESTADO" />
                                </columns>
                            </TableView>

                        </VBox>

                    </VBox>

                </HBox>

            </VBox>
        </ScrollPane>

    </VBox>

</StackPane>
