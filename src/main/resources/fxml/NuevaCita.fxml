<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: rgba(0,0,0,0.6);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.NuevaCitaController">

    <VBox maxHeight="620" maxWidth="600" style="-fx-background-color: rgba(26,29,33,0.95);                  -fx-background-radius: 12;                  -fx-border-color: rgba(255,255,255,0.05);                  -fx-border-width: 1;                  -fx-border-radius: 12;                  -fx-effect: dropshadow(gaussian, rgba(202,243,0,0.2), 20, 0, 0, 0);">

        <!-- ── HEADER ── -->
        <HBox alignment="CENTER_LEFT" prefHeight="64" style="-fx-background-color: #1a1c1f;                      -fx-background-radius: 12 12 0 0;                      -fx-border-color: rgba(255,255,255,0.05);                      -fx-border-width: 0 0 1 0;">
            <padding><Insets left="24" right="24" /></padding>

            <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: white;">
                AGENDAR CITA / SESIÓN
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnCerrar" onAction="#handleCerrar" prefHeight="32" prefWidth="32" style="-fx-background-color: #282a2d; -fx-background-radius: 8;                            -fx-border-color: #333538; -fx-border-width: 1; -fx-border-radius: 8;                            -fx-cursor: hand; -fx-text-fill: #6b7280; -fx-font-family: 'Space Grotesk'; -fx-font-weight: 700;" text="X" />
        </HBox>

        <!-- ── BODY ── -->
        <VBox spacing="16" style="-fx-background-color: #1a1d21; -fx-background-radius: 0 0 12 12;" VBox.vgrow="ALWAYS">
            <padding><Insets left="24" right="24" top="20" bottom="20" /></padding>

            <!-- Cliente -->
            <VBox spacing="6">
                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="CLIENTE" />
                <ComboBox fx:id="cmbCliente" maxWidth="Infinity" prefHeight="44" promptText="Seleccionar cliente" style="-fx-background-color: #121417; -fx-background-radius: 8;                                    -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8;                                    -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: white;" />
            </VBox>

            <!-- Instructor -->
            <VBox spacing="6">
                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="INSTRUCTOR" />
                <ComboBox fx:id="cmbInstructor" maxWidth="Infinity" prefHeight="44" promptText="Seleccionar instructor" style="-fx-background-color: #121417; -fx-background-radius: 8;                                    -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8;                                    -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: white;" />
            </VBox>

            <!-- Fecha y Hora -->
            <HBox spacing="16">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="FECHA" />
                    <DatePicker fx:id="dpFecha" maxWidth="Infinity" prefHeight="44" promptText="dd/mm/aaaa" style="-fx-background-color: #121417; -fx-background-radius: 8;                                          -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8;                                          -fx-font-family: 'Inter'; -fx-font-size: 13px;" />
                </VBox>
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="HORA" />
                    <ComboBox fx:id="cmbHora" maxWidth="Infinity" prefHeight="44" promptText="Seleccionar hora" style="-fx-background-color: #121417; -fx-background-radius: 8;                                     -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8;                                     -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: white;" />
                </VBox>
            </HBox>

            <!-- Tipo de Cita -->
            <VBox spacing="6">
                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TIPO DE CITA" />
                <ComboBox fx:id="cmbTipoCita" maxWidth="Infinity" prefHeight="44" promptText="Seleccionar tipo" style="-fx-background-color: #121417; -fx-background-radius: 8;                                    -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8;                                    -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: white;" />
            </VBox>

            <!-- Notas -->
            <VBox spacing="6" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="NOTAS" />
                <TextArea fx:id="txtNotas" prefHeight="72" promptText="Notas adicionales..." style="-fx-background-color: #121417; -fx-background-radius: 8;                                    -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1; -fx-border-radius: 8;                                    -fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: white;                                    -fx-control-inner-background: #121417;" wrapText="true">
                    <padding><Insets bottom="10" left="12" right="12" top="10" /></padding>
                </TextArea>
            </VBox>

            <!-- ── FOOTER ── -->
            <HBox alignment="CENTER_RIGHT" spacing="12" prefHeight="56" style="-fx-border-color: rgba(255,255,255,0.03); -fx-border-width: 1 0 0 0;">
                <padding><Insets top="12" /></padding>
                <Button fx:id="btnCancelar" onAction="#handleCerrar" prefHeight="42" prefWidth="140" style="-fx-background-color: transparent; -fx-background-radius: 8;                                 -fx-border-color: #333538; -fx-border-width: 2; -fx-border-radius: 8;                                 -fx-font-family: 'Space Grotesk'; -fx-font-size: 13px; -fx-font-weight: 700;                                 -fx-text-fill: #9ca3af; -fx-cursor: hand;" text="Cancelar" />
                <Button fx:id="btnGuardar" onAction="#handleGuardar" prefHeight="42" prefWidth="180" style="-fx-background-color: #D4FF00; -fx-background-radius: 8;                                 -fx-font-family: 'Space Grotesk'; -fx-font-size: 13px; -fx-font-weight: 700;                                 -fx-text-fill: #121417; -fx-cursor: hand;" text="  Agendar Cita">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" pickOnBounds="true" preserveRatio="true">
                            <image><Image url="@../images/guardar.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
