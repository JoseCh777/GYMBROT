<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<BorderPane prefHeight="900" prefWidth="1440" style="-fx-background-color: #111316;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.DashboardController">

    <!-- LEFT: SideNav -->
    <left>
        <VBox fx:id="sideNav" minWidth="256" prefWidth="256" style="-fx-background-color: #121417; -fx-border-color: #1f2125; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>

            <VBox spacing="2">
                <VBox.margin><Insets bottom="32" left="16" /></VBox.margin>
                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 28px; -fx-font-weight: 900;                               -fx-font-style: italic; -fx-text-fill: #D4FF00;" text="GYMBROT" />
                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700;                               -fx-text-fill: #6b7280;" />
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboard" maxWidth="Infinity" onAction="#handleNavDashboard" prefHeight="44" style="-fx-background-color: #D4FF00; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 700;                                -fx-text-fill: black; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Dashboard" />
                <Button fx:id="navClientes" maxWidth="Infinity" onAction="#handleNavClientes" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Clientes" />
                <Button fx:id="navInstructores" maxWidth="Infinity" onAction="#handleNavInstructores" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Instructores" />
                <Button fx:id="navMembresias" maxWidth="Infinity" onAction="#handleNavMembresias" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Membresias" />
                <Button fx:id="navAI" maxWidth="Infinity" onAction="#handleNavAI" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Gymbrot AI" />
            </VBox>

            <Separator opacity="0.1">
                <VBox.margin><Insets bottom="8" top="16" /></VBox.margin>
            </Separator>

            <VBox spacing="8">
                <Button maxWidth="Infinity" onAction="#handleNavConfig" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Configuracion" />
                <Button maxWidth="Infinity" onAction="#handleLogout" prefHeight="44" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;                                -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="  Cerrar Sesion" />
            </VBox>
        </VBox>
    </left>

    <!-- TOP: TopBar -->
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="64" style="-fx-background-color: #1a1d21; -fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;">
            <padding><Insets left="32" right="32" /></padding>

            <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 18px; -fx-font-weight: 700;                           -fx-text-fill: white;" />
            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="16">
                <HBox.margin><Insets right="24" /></HBox.margin>
                <Label style="-fx-font-size: 13px; -fx-text-fill: #D4FF00; -fx-cursor: hand;" text="Notif." />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #D4FF00; -fx-cursor: hand;" text="Historial" />
                <Label style="-fx-font-size: 13px; -fx-text-fill: #D4FF00; -fx-cursor: hand;" text="Chat" />
            </HBox>
        </HBox>
    </top>

    <!-- CENTER: Contenido -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: #111316; -fx-background-color: #111316; -fx-border-width: 0;">
            <VBox spacing="32">
                <padding><Insets bottom="80" left="32" right="32" top="32" /></padding>

                <!-- SECCION 1: Metricas -->
                <HBox spacing="20">

                    <!-- Card: Total Miembros -->
                    <VBox spacing="8" style="-fx-background-color: #1a1d21; -fx-background-radius: 12;                                  -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TOTAL DE MIEMBROS" />
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="lblTotalMiembros" style="-fx-font-family: 'Lexend'; -fx-font-size: 48px;                                           -fx-font-weight: 800; -fx-text-fill: #D4FF00;" text="0" HBox.hgrow="ALWAYS" />
                            <!-- CORREGIDO: "+0%" → "0%" — el + fuera de style rompe FXML -->
                            <Label fx:id="lblMiembrosTrend" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px;                                           -fx-font-weight: 700; -fx-text-fill: #bdf4ff;" text="0%" />
                        </HBox>
                        <ProgressBar fx:id="pbMiembros" maxWidth="Infinity" prefHeight="4" progress="0" style="-fx-accent: #D4FF00; -fx-background-color: #2a2d30;                                             -fx-background-radius: 4; -fx-border-width: 0;" />
                    </VBox>

                    <!-- Card: Activos Ahora -->
                    <VBox spacing="8" style="-fx-background-color: #1a1d21; -fx-background-radius: 12;                                  -fx-border-color: #bdf4ff; -fx-border-width: 0 0 0 4; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="ACTIVOS AHORA" />
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="lblActivosAhora" prefHeight="70.0" prefWidth="70.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 48px;                                           -fx-font-weight: 800; -fx-text-fill: white;" text="0" HBox.hgrow="ALWAYS" />
                            <HBox alignment="CENTER" spacing="6">
                                <Rectangle fx:id="dotActivos" arcHeight="10" arcWidth="10" height="10" style="-fx-fill: #bdf4ff;" width="10" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: #bdf4ff;" text="EN VIVO" />
                            </HBox>
                        </HBox>
                        <HBox spacing="3">
                            <Region prefHeight="4" prefWidth="50" style="-fx-background-color: #bdf4ff; -fx-background-radius: 2;" />
                            <Region prefHeight="4" prefWidth="50" style="-fx-background-color: #bdf4ff; -fx-background-radius: 2;" />
                            <Region prefHeight="4" prefWidth="50" style="-fx-background-color: #3a5a60; -fx-background-radius: 2;" />
                            <Region prefHeight="4" style="-fx-background-color: #2a2d30; -fx-background-radius: 2;" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>

                    <!-- Card: Ingresos -->
                    <VBox spacing="8" style="-fx-background-color: #1a1d21; -fx-background-radius: 12;                                  -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="16" left="16" right="16" top="16" /></padding>
                        <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                       -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="INGRESOS ESTE MES" />
                        <HBox alignment="BOTTOM_LEFT">
                            <Label fx:id="lblIngresos" prefHeight="70.0" prefWidth="104.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 48px;                                           -fx-font-weight: 800; -fx-text-fill: white;" text="0" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblIngresosStatus" prefHeight="40.0" prefWidth="65.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px;                                           -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="Cargando..." />
                        </HBox>
                        <HBox>
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                           -fx-text-fill: #6b7280;" text="PROGRESO HACIA EL OBJETIVO" HBox.hgrow="ALWAYS" />
                            <Label fx:id="lblIngresosProgreso" prefHeight="18.0" prefWidth="33.0" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px;                                           -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="0%" />
                        </HBox>
                    </VBox>

                </HBox>

                <!-- SECCION 2: Graficas -->
                <HBox alignment="TOP_LEFT" spacing="20">

                    <!-- Asistencia Semanal -->
                    <VBox minHeight="400" prefHeight="400.0" prefWidth="741.0" spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12;                                  -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;" HBox.hgrow="ALWAYS">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                        <HBox alignment="CENTER_LEFT">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px;                                               -fx-font-weight: 600; -fx-text-fill: white;" text="Asistencia Semanal" />
                                <Label style="-fx-font-family: 'Inter'; -fx-font-size: 13px;                                               -fx-text-fill: #6b7280;" text="Ingresos de miembros - ultimos 7 dias" />
                            </VBox>
                            <HBox spacing="8">
                                <Button fx:id="btnDiario" onAction="#handleViewDiario" prefHeight="30" style="-fx-background-color: #282a2d; -fx-background-radius: 8;                                                -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                                -fx-font-weight: 700; -fx-text-fill: white;                                                -fx-border-color: #333538; -fx-border-width: 1;                                                -fx-border-radius: 8; -fx-cursor: hand;" text="Diario" />
                                <Button fx:id="btnSemanal" onAction="#handleViewSemanal" prefHeight="30" style="-fx-background-color: #D4FF00; -fx-background-radius: 8;                                                -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                                -fx-font-weight: 700; -fx-text-fill: black; -fx-cursor: hand;" text="Semanal" />
                            </HBox>
                        </HBox>

                        <HBox fx:id="chartAsistencia" alignment="BOTTOM_CENTER" prefHeight="200" spacing="8" style="-fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;" VBox.vgrow="ALWAYS">
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barLun" maxWidth="8" prefHeight="40" style="-fx-background-color: #2a4a50; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="LUN" />
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barMar" maxWidth="8" prefHeight="90" style="-fx-background-color: #2a4a50; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="MAR" />
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barMie" maxWidth="8" prefHeight="150" style="-fx-background-color: #D4FF00; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="MIE" />
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barJue" maxWidth="8" prefHeight="110" style="-fx-background-color: #2a4a50; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="JUE" />
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barVie" maxWidth="8" prefHeight="70" style="-fx-background-color: #2a4a50; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="VIE" />
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barSab" maxWidth="8" prefHeight="180" style="-fx-background-color: #2a4a50; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="SAB" />
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region fx:id="barDom" maxWidth="8" prefHeight="130" style="-fx-background-color: #2a4a50; -fx-background-radius: 2;" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="DOM" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Demografia en Vivo -->
                    <VBox minWidth="260" prefHeight="400.0" prefWidth="342.0" spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12;                                  -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                        <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px;                                       -fx-font-weight: 600; -fx-text-fill: white;" text="Demografia en Vivo" />

                        <!-- Adulto -->
                        <HBox alignment="CENTER_LEFT" spacing="16" VBox.vgrow="ALWAYS">
                            <VBox alignment="CENTER" prefHeight="56" prefWidth="56" style="-fx-background-color: #1e2a00; -fx-background-radius: 28;                                          -fx-border-color: #D4FF00; -fx-border-width: 3; -fx-border-radius: 28;">
                                <Label fx:id="lblPctAdulto" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: #D4FF00;" text="0%" />
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox>
                                    <Label prefHeight="20.0" prefWidth="137.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                                   -fx-font-weight: 700; -fx-text-fill: white;" text="Adulto" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblCntAdulto" style="-fx-font-family: 'Inter'; -fx-font-size: 11px;                                                   -fx-text-fill: #6b7280;" text="0 presentes" />
                                </HBox>
                                <Label style="-fx-font-family: 'Inter'; -fx-font-size: 12px;                                               -fx-text-fill: #6b7280;" text="18-55 anos" />
                            </VBox>
                        </HBox>

                        <!-- Menor de Edad -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox alignment="CENTER" prefHeight="56" prefWidth="56" style="-fx-background-color: #002a30; -fx-background-radius: 28;                                          -fx-border-color: #bdf4ff; -fx-border-width: 3; -fx-border-radius: 28;">
                                <Label fx:id="lblPctMenor" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: #bdf4ff;" text="0%" />
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox>
                                    <Label prefHeight="20.0" prefWidth="142.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                                   -fx-font-weight: 700; -fx-text-fill: white;" text="Menor de Edad" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblCntMenor" style="-fx-font-family: 'Inter'; -fx-font-size: 11px;                                                   -fx-text-fill: #6b7280;" text="0 presentes" />
                                </HBox>
                                <Label style="-fx-font-family: 'Inter'; -fx-font-size: 12px;                                               -fx-text-fill: #6b7280;" text="Bajo 18 anos" />
                            </VBox>
                        </HBox>

                        <!-- Senior -->
                        <!-- CORREGIDO: "55+ anos" → "55 anos y mas" — el + en text= rompe FXML -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox alignment="CENTER" prefHeight="56" prefWidth="56" style="-fx-background-color: #252729; -fx-background-radius: 28;                                          -fx-border-color: #aaaaaa; -fx-border-width: 3; -fx-border-radius: 28;">
                                <Label fx:id="lblPctSenior" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                               -fx-font-weight: 700; -fx-text-fill: white;" text="0%" />
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox>
                                    <Label prefHeight="20.0" prefWidth="140.0" style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;                                                   -fx-font-weight: 700; -fx-text-fill: white;" text="Señor" HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblCntSenior" prefHeight="16.0" prefWidth="62.0" style="-fx-font-family: 'Inter'; -fx-font-size: 11px;                                                   -fx-text-fill: #6b7280;" text="0 presentes" />
                                </HBox>
                                <Label style="-fx-font-family: 'Inter'; -fx-font-size: 12px;                                               -fx-text-fill: #6b7280;" text="55 anos y mas" />
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <Button maxWidth="Infinity" onAction="#handleVerRegistro" prefHeight="44" style="-fx-background-color: #282a2d; -fx-background-radius: 8;                                        -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 700;                                        -fx-text-fill: white; -fx-border-color: #333538; -fx-border-width: 1;                                        -fx-border-radius: 8; -fx-cursor: hand;" text="Ver Registro Detallado" />
                    </VBox>

                </HBox>

                <!-- SECCION 3: Horas Pico -->
                <VBox spacing="20" style="-fx-background-color: #1a1d21; -fx-background-radius: 12;                              -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                    <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                    <HBox alignment="BOTTOM_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px;                                           -fx-font-weight: 700; -fx-text-fill: white;" text="HORAS PICO DE OPERACION" />
                            <Label style="-fx-font-family: 'Inter'; -fx-font-size: 13px;                                           -fx-text-fill: #6b7280;" text="Ocupacion diaria promedio por hora" />
                        </VBox>
                        <HBox alignment="CENTER" spacing="16">
                            <HBox alignment="CENTER" spacing="6">
                                <Rectangle arcHeight="8" arcWidth="8" height="8" style="-fx-fill: #D4FF00;" width="8" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="TRAFICO ALTO" />
                            </HBox>
                            <HBox alignment="CENTER" spacing="6">
                                <Rectangle arcHeight="8" arcWidth="8" height="8" style="-fx-fill: #3a5a60;" width="8" />
                                <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;                                               -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="MODERADO" />
                            </HBox>
                        </HBox>
                    </HBox>

                    <HBox fx:id="chartHorasPico" alignment="BOTTOM_LEFT" prefHeight="192" spacing="4" style="-fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;">
                        <Region fx:id="h06" maxHeight="38" prefHeight="38" style="-fx-background-color: #2a2d30; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
                        <Region fx:id="h07" maxHeight="67" prefHeight="67" style="-fx-background-color: #2a2d30; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
                        <Region fx:id="h08" maxHeight="96" prefHeight="96" style="-fx-background-color: #3a5a60; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
                        <Region fx:id="h09" maxHeight="125" prefHeight="125" style="-fx-background-color: #3a5a60; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
                        <Region fx:id="h10" maxHeight="182" prefHeight="182" style="-fx-background-color: #D4FF00; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
                        <Region fx:id="h11" maxHeight="154" prefHeight="154" style="-fx-background-color: #D4FF00; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
                        <Region fx:id="h12" maxHeight="115" prefHeight="115" style="-fx-background-color: #3a5a60; -fx-background-radius: 3 3 0 0;" HBox.hgrow="ALWAYS" />
