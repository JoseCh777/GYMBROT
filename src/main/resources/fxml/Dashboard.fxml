<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.gymbrot.controller."
        prefWidth="1440"
        prefHeight="900"
        style="-fx-background-color: #111316;">

    <left>
        <VBox
                fx:id="sideNav"
                prefWidth="256"
                minWidth="256"
                style="-fx-background-color: #121417;
                   -fx-border-color: #1f2125;
                   -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="16" right="16" bottom="16" left="16"/>
            </padding>

            <VBox spacing="2">
                <VBox.margin>
                    <Insets bottom="32" left="16"/>
                </VBox.margin>
                <Label text="TITAN"
                       style="-fx-font-family: 'Lexend'; -fx-font-size: 28px; -fx-font-weight: 900;
                           -fx-font-style: italic; -fx-text-fill: #D4FF00;"/>
                <Label text="RENDIMIENTO DE ÉLITE"
                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700;
                           -fx-text-fill: #6b7280;"/>
            </VBox>

            <VBox spacing="8" VBox.vgrow="ALWAYS">
                <Button fx:id="navDashboard" text="   Dashboard" maxWidth="Infinity" prefHeight="44"
                        onAction="#handleNavDashboard"
                        style="-fx-background-color: #D4FF00; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 700;
                           -fx-text-fill: black; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
                <Button fx:id="navClientes" text="   Clientes" maxWidth="Infinity" prefHeight="44"
                        onAction="#handleNavClientes"
                        style="-fx-background-color: transparent; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;
                           -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
                <Button fx:id="navInstructores" text="   Instructores" maxWidth="Infinity" prefHeight="44"
                        onAction="#handleNavInstructores"
                        style="-fx-background-color: transparent; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;
                           -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
                <Button fx:id="navMembresias" text="   Membresias" maxWidth="Infinity" prefHeight="44"
                        onAction="#handleNavMembresias"
                        style="-fx-background-color: transparent; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;
                           -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
                <Button fx:id="navAI" text="   Gymbrot AI" maxWidth="Infinity" prefHeight="44"
                        onAction="#handleNavAI"
                        style="-fx-background-color: transparent; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;
                           -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            </VBox>

            <Separator opacity="0.1">
                <VBox.margin><Insets top="16" bottom="8"/></VBox.margin>
            </Separator>

            <VBox spacing="8">
                <Button text="   Configuracion" maxWidth="Infinity" prefHeight="44" onAction="#handleNavConfig"
                        style="-fx-background-color: transparent; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;
                           -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
                <Button text="   Cerrar Sesion" maxWidth="Infinity" prefHeight="44" onAction="#handleLogout"
                        style="-fx-background-color: transparent; -fx-background-radius: 8;
                           -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 500;
                           -fx-text-fill: #9ca3af; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="64"
              style="-fx-background-color: #1a1d21;
                   -fx-border-color: #1f2125;
                   -fx-border-width: 0 0 1 0;">
            <padding><Insets left="32" right="32"/></padding>

            <Label text="Titan Command"
                   style="-fx-font-family: 'Lexend'; -fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField" promptText="Buscar sistemas..."
                       prefWidth="256" prefHeight="36"
                       style="-fx-background-color: #0c0e11; -fx-background-radius: 18;
                       -fx-font-family: 'Inter'; -fx-font-size: 13px;
                       -fx-text-fill: #e2e2e6; -fx-prompt-text-fill: #6b7280;
                       -fx-padding: 8 16 8 16; -fx-border-width: 0;">
                <HBox.margin><Insets right="24"/></HBox.margin>
            </TextField>

            <HBox alignment="CENTER" spacing="16">
                <HBox.margin><Insets right="24"/></HBox.margin>
                <Label text="Notif." style="-fx-font-size: 13px; -fx-text-fill: #D4FF00; -fx-cursor: hand;"/>
                <Label text="Historial" style="-fx-font-size: 13px; -fx-text-fill: #D4FF00; -fx-cursor: hand;"/>
                <Label text="Chat" style="-fx-font-size: 13px; -fx-text-fill: #D4FF00; -fx-cursor: hand;"/>
            </HBox>

            <StackPane prefWidth="36" prefHeight="36"
                       style="-fx-background-color: #333538; -fx-background-radius: 18;
                       -fx-border-color: #3a3d41; -fx-border-width: 1; -fx-border-radius: 18;">
                <ImageView fx:id="avatarImage" fitWidth="36" fitHeight="36">
                    <image>
                        <Image url="https://lh3.googleusercontent.com/aida-public/AB6AXuAxFIHnAQpYy4z_G-zAJK9hqlDIUtW4xvS5C4lc3Mw-zi9-wH1T9NQPHhzQExSUsPanDBvm3HTxqiCzlUnbzcVjaoG1szAQcjmd2yzUtYyU9josNDAe2jotaqp60l2DN-Wy8JqLNqK7AGr8Z5L9hF10anYb0S3iDNzRNGuv8QUaDjGZE9DIdNUesoM4eoGj6RbX-xMGr2LviJP20i5HpY2GYu0MaDvuMEWN59uzJFkpsPyrTjtwTLFQvOTSdtiMvdRX_pXS8_yBG-4"/>
                    </image>
                </ImageView>
            </StackPane>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background: #111316; -fx-background-color: #111316; -fx-border-width: 0;">

            <VBox spacing="32">
                <padding>
                    <Insets top="32" right="32" bottom="80" left="32"/>
                </padding>

                <!-- SECCIÓN 1: Métricas -->
                <HBox spacing="20">

                    <!-- Card: Total Miembros -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #1a1d21; -fx-background-radius: 12;
                               -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <Label text="TOTAL DE MIEMBROS"
                               style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                   -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <HBox alignment="BOTTOM_LEFT">
                            <Label text="2,842" HBox.hgrow="ALWAYS"
                                   style="-fx-font-family: 'Lexend'; -fx-font-size: 48px;
                                       -fx-font-weight: 800; -fx-text-fill: #D4FF00;"/>
                            <Label text="12%"
                                   style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px;
                                       -fx-font-weight: 700; -fx-text-fill: #bdf4ff;"/>
                        </HBox>
                        <ProgressBar progress="0.80" maxWidth="Infinity" prefHeight="4"
                                     style="-fx-accent: #D4FF00; -fx-background-color: #2a2d30;
                                   -fx-background-radius: 4; -fx-border-width: 0;"/>
                    </VBox>

                    <!-- Card: Activos Ahora -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #1a1d21; -fx-background-radius: 12;
                               -fx-border-color: #bdf4ff; -fx-border-width: 0 0 0 4; -fx-border-radius: 12;">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <Label text="ACTIVOS AHORA"
                               style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                   -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <HBox alignment="BOTTOM_LEFT">
                            <Label text="184" HBox.hgrow="ALWAYS"
                                   style="-fx-font-family: 'Lexend'; -fx-font-size: 48px;
                                       -fx-font-weight: 800; -fx-text-fill: white;"/>
                            <HBox alignment="CENTER" spacing="6">
                                <Circle radius="5" style="-fx-fill: #bdf4ff;"/>
                                <Label text="EN VIVO"
                                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-text-fill: #bdf4ff;"/>
                            </HBox>
                        </HBox>
                        <HBox spacing="3">
                            <Region prefHeight="4" prefWidth="50" style="-fx-background-color: #bdf4ff; -fx-background-radius: 2;"/>
                            <Region prefHeight="4" prefWidth="50" style="-fx-background-color: #bdf4ff; -fx-background-radius: 2;"/>
                            <Region prefHeight="4" prefWidth="50" style="-fx-background-color: #3a5a60; -fx-background-radius: 2;"/>
                            <Region prefHeight="4" HBox.hgrow="ALWAYS" style="-fx-background-color: #2a2d30; -fx-background-radius: 2;"/>
                        </HBox>
                    </VBox>

                    <!-- Card: Ingresos -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color: #1a1d21; -fx-background-radius: 12;
                               -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                        <Label text="INGRESOS ESTE MES"
                               style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                   -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                        <HBox alignment="BOTTOM_LEFT">
                            <Label text="$42.8k" HBox.hgrow="ALWAYS"
                                   style="-fx-font-family: 'Lexend'; -fx-font-size: 48px;
                                       -fx-font-weight: 800; -fx-text-fill: white;"/>
                            <Label text="Meta Alcanzada"
                                   style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px;
                                       -fx-font-weight: 700; -fx-text-fill: #D4FF00;"/>
                        </HBox>
                        <HBox>
                            <Label text="PROGRESO HACIA EL OBJETIVO" HBox.hgrow="ALWAYS"
                                   style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;
                                       -fx-text-fill: #6b7280;"/>
                            <Label text="94%"
                                   style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 12px;
                                       -fx-font-weight: 700; -fx-text-fill: #D4FF00;"/>
                        </HBox>
                    </VBox>

                </HBox>

                <!-- SECCIÓN 2: Graficas -->
                <HBox spacing="20" alignment="TOP_LEFT">

                    <!-- Asistencia Semanal -->
                    <VBox spacing="20" HBox.hgrow="ALWAYS" prefWidth="580" minHeight="400"
                          style="-fx-background-color: #1a1d21; -fx-background-radius: 12;
                               -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                        <HBox alignment="CENTER_LEFT">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="Asistencia Semanal"
                                       style="-fx-font-family: 'Lexend'; -fx-font-size: 22px;
                                           -fx-font-weight: 600; -fx-text-fill: white;"/>
                                <Label text="Ingresos de miembros vs ultimos 7 dias"
                                       style="-fx-font-family: 'Inter'; -fx-font-size: 13px;
                                           -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <HBox spacing="8">
                                <Button text="Diario" prefHeight="30"
                                        style="-fx-background-color: #282a2d; -fx-background-radius: 8;
                                           -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-text-fill: white;
                                           -fx-border-color: #333538; -fx-border-width: 1;
                                           -fx-border-radius: 8; -fx-cursor: hand;"/>
                                <Button text="Semanal" prefHeight="30"
                                        style="-fx-background-color: #D4FF00; -fx-background-radius: 8;
                                           -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-text-fill: black; -fx-cursor: hand;"/>
                            </HBox>
                        </HBox>

                        <!-- Barras del chart -->
                        <HBox spacing="8" alignment="BOTTOM_CENTER" VBox.vgrow="ALWAYS" prefHeight="200"
                              style="-fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;">
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="40" maxHeight="40" maxWidth="4"
                                        style="-fx-background-color: #2a4a50; -fx-background-radius: 2;"/>
                                <Label text="LUN" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="90" maxHeight="90" maxWidth="4"
                                        style="-fx-background-color: #2a4a50; -fx-background-radius: 2;"/>
                                <Label text="MAR" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="150" maxHeight="150" maxWidth="4"
                                        style="-fx-background-color: #D4FF00; -fx-background-radius: 2;"/>
                                <Label text="MIE" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #D4FF00;"/>
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="110" maxHeight="110" maxWidth="4"
                                        style="-fx-background-color: #2a4a50; -fx-background-radius: 2;"/>
                                <Label text="JUE" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="70" maxHeight="70" maxWidth="4"
                                        style="-fx-background-color: #2a4a50; -fx-background-radius: 2;"/>
                                <Label text="VIE" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="180" maxHeight="180" maxWidth="4"
                                        style="-fx-background-color: #2a4a50; -fx-background-radius: 2;"/>
                                <Label text="SAB" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </VBox>
                            <VBox alignment="BOTTOM_CENTER" spacing="6" HBox.hgrow="ALWAYS">
                                <Region prefHeight="130" maxHeight="130" maxWidth="4"
                                        style="-fx-background-color: #2a4a50; -fx-background-radius: 2;"/>
                                <Label text="DOM" style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px; -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Demografia en Vivo -->
                    <VBox spacing="20" prefWidth="280" minWidth="260"
                          style="-fx-background-color: #1a1d21; -fx-background-radius: 12;
                               -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                        <Label text="Demografia en Vivo"
                               style="-fx-font-family: 'Lexend'; -fx-font-size: 22px;
                                   -fx-font-weight: 600; -fx-text-fill: white;"/>

                        <!-- Adulto -->
                        <HBox alignment="CENTER_LEFT" spacing="16" VBox.vgrow="ALWAYS">
                            <VBox alignment="CENTER" prefWidth="56" prefHeight="56"
                                  style="-fx-background-color: #1e2a00; -fx-background-radius: 28;
                                       -fx-border-color: #D4FF00; -fx-border-width: 3; -fx-border-radius: 28;">
                                <Label text="65%"
                                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-text-fill: #D4FF00;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox>
                                    <Label text="Adulto" HBox.hgrow="ALWAYS"
                                           style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;
                                               -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="120 presentes"
                                           style="-fx-font-family: 'Inter'; -fx-font-size: 11px;
                                               -fx-text-fill: #6b7280;"/>
                                </HBox>
                                <Label text="18-55 anos"
                                       style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>

                        <!-- Menor de Edad -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox alignment="CENTER" prefWidth="56" prefHeight="56"
                                  style="-fx-background-color: #002a30; -fx-background-radius: 28;
                                       -fx-border-color: #bdf4ff; -fx-border-width: 3; -fx-border-radius: 28;">
                                <Label text="18%"
                                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-text-fill: #bdf4ff;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox>
                                    <Label text="Menor de Edad" HBox.hgrow="ALWAYS"
                                           style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;
                                               -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="33 presentes"
                                           style="-fx-font-family: 'Inter'; -fx-font-size: 11px;
                                               -fx-text-fill: #6b7280;"/>
                                </HBox>
                                <Label text="Bajo 18 anos"
                                       style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>

                        <!-- Senior -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox alignment="CENTER" prefWidth="56" prefHeight="56"
                                  style="-fx-background-color: #252729; -fx-background-radius: 28;
                                       -fx-border-color: #aaaaaa; -fx-border-width: 3; -fx-border-radius: 28;">
                                <Label text="17%"
                                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;
                                           -fx-font-weight: 700; -fx-text-fill: white;"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS">
                                <HBox>
                                    <Label text="Senior" HBox.hgrow="ALWAYS"
                                           style="-fx-font-family: 'Lexend'; -fx-font-size: 14px;
                                               -fx-font-weight: 700; -fx-text-fill: white;"/>
                                    <Label text="31 presentes"
                                           style="-fx-font-family: 'Inter'; -fx-font-size: 11px;
                                               -fx-text-fill: #6b7280;"/>
                                </HBox>
                                <Label text="55+ anos"
                                       style="-fx-font-family: 'Inter'; -fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <Button text="Ver Registro Detallado" maxWidth="Infinity" prefHeight="44"
                                onAction="handleVerRegistro"
                                style="-fx-background-color: #282a2d; -fx-background-radius: 8;
                                   -fx-font-family: 'Lexend'; -fx-font-size: 14px; -fx-font-weight: 700;
                                   -fx-text-fill: white; -fx-border-color: #333538; -fx-border-width: 1;
                                   -fx-border-radius: 8; -fx-cursor: hand;"/>
                    </VBox>

                </HBox>

                <!-- SECCIÓN 3: Horas Pico -->
                <VBox spacing="20"
                      style="-fx-background-color: #1a1d21; -fx-background-radius: 12;
                           -fx-border-color: #1f2125; -fx-border-width: 1; -fx-border-radius: 12;">
                    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                    <HBox alignment="BOTTOM_LEFT">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label text="HORAS PICO DE OPERACION"
                                   style="-fx-font-family: 'Lexend'; -fx-font-size: 22px;
                                       -fx-font-weight: 700; -fx-text-fill: white;"/>
                            <Label text="Ocupacion diaria promedio por hora"
                                   style="-fx-font-family: 'Inter'; -fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
                        </VBox>
                        <HBox spacing="16" alignment="CENTER">
                            <HBox spacing="6" alignment="CENTER">
                                <Circle radius="4" style="-fx-fill: #D4FF00;"/>
                                <Label text="TRAFICO ALTO"
                                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;
                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER">
                                <Circle radius="4" style="-fx-fill: #3a5a60;"/>
                                <Label text="MODERADO"
                                       style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 10px;
                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;"/>
                            </HBox>
                        </HBox>
                    </HBox>

                    <HBox spacing="4" alignment="BOTTOM_LEFT" prefHeight="192"
                          style="-fx-border-color: #1f2125; -fx-border-width: 0 0 1 0;">
                        <Region HBox.hgrow="ALWAYS" prefHeight="38"  maxHeight="38"  style="-fx-background-color: #2a2d30; -fx-background-radius: 3 3 0 0;"/>
                        <Region HBox.hgrow="ALWAYS" prefHeight="67"  maxHeight="67"  style="-fx-background-color: #2a2d30; -fx-background-radius: 3 3 0 0;"/>
