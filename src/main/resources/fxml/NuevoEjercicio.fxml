<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Overlay: fondo semitransparente — igual que NuevaRutina -->

<StackPane style="-fx-background-color: rgba(0,0,0,0.6);" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.gymbrot.controller.NuevoEjercicioController">

    <!-- Modal principal — mismos estilos que NuevaRutina -->
    <VBox maxHeight="510" maxWidth="670" style="-fx-background-color: rgba(26,29,33,0.95);                  -fx-background-radius: 12;                  -fx-border-color: rgba(255,255,255,0.05);                  -fx-border-width: 1;                  -fx-border-radius: 12;                  -fx-effect: dropshadow(gaussian, rgba(202,243,0,0.2), 20, 0, 0, 0);">

        <!-- ── HEADER — idéntico a NuevaRutina ── -->
        <HBox alignment="CENTER_LEFT" prefHeight="64" style="-fx-background-color: #1a1c1f;                      -fx-background-radius: 12 12 0 0;                      -fx-border-color: rgba(255,255,255,0.05);                      -fx-border-width: 0 0 1 0;">
            <padding><Insets left="24" right="24" /></padding>

            <ImageView fitHeight="22" fitWidth="22" preserveRatio="true">
                <image><Image url="@../images/fitness_center.png" /></image>
            </ImageView>

            <Label style="-fx-font-family: 'Lexend'; -fx-font-size: 22px; -fx-font-weight: 700;                           -fx-text-fill: #D4FF00; -fx-padding: 0 0 0 12;">
                NUEVO EJERCICIO
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnCerrar" onAction="#handleCerrar" style="-fx-background-color: transparent; -fx-background-radius: 20;                            -fx-cursor: hand; -fx-padding: 6 6 6 6;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20" preserveRatio="true">
                        <image><Image url="@../images/close.png" /></image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- ── CONTENIDO CON SCROLL — igual que NuevaRutina ── -->
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-width: 0;" VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding><Insets bottom="24" left="24" right="24" top="24" /></padding>

                <!-- GRID PRINCIPAL: izquierda + derecha -->
                <HBox spacing="24">

                    <!-- ── COLUMNA IZQUIERDA ── -->
                    <VBox spacing="20" HBox.hgrow="ALWAYS">

                        <!-- Nombre del Ejercicio -->
                        <VBox prefHeight="93.0" prefWidth="226.0" spacing="6">
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="NOMBRE DEL EJERCICIO" />
                            <TextField fx:id="txtNombre" promptText="Ej. Sentadilla con Barra" style="-fx-background-color: #0c0e11;                                               -fx-border-color: rgba(255,255,255,0.1);                                               -fx-border-width: 1; -fx-border-radius: 8;                                               -fx-background-radius: 8;                                               -fx-font-family: 'Space Grotesk'; -fx-font-size: 15px;                                               -fx-text-fill: #e2e2e6; -fx-prompt-text-fill: #4b5563;                                               -fx-padding: 12 14 12 14;" />
                        </VBox>

                        <!-- Grupo Muscular -->
                        <VBox prefHeight="82.0" prefWidth="226.0" spacing="6">
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="GRUPO MUSCULAR" />
                            <!-- Se puebla desde controller con datos de EJERCICIOS.grupo_muscular distintos -->
                            <ComboBox fx:id="cmbGrupoMuscular" maxWidth="Infinity" promptText="Seleccionar Grupo Muscular" style="-fx-background-color: #1a1c1f;                                              -fx-border-color: rgba(255,255,255,0.1);                                              -fx-border-width: 1; -fx-border-radius: 8;                                              -fx-background-radius: 8;                                              -fx-font-family: 'Inter'; -fx-font-size: 14px;                                              -fx-text-fill: #e2e2e6;" />
                        </VBox>

                        <!-- Nivel / Dificultad -->
                        <VBox spacing="6">
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="NIVEL / DIFICULTAD" />
                            <ComboBox fx:id="cmbNivel" maxWidth="Infinity" promptText="Seleccionar Nivel" style="-fx-background-color: #1a1c1f;                                              -fx-border-color: rgba(255,255,255,0.1);                                              -fx-border-width: 1; -fx-border-radius: 8;                                              -fx-background-radius: 8;                                              -fx-font-family: 'Inter'; -fx-font-size: 14px;                                              -fx-text-fill: #e2e2e6;" />
                        </VBox>

                    </VBox>

                    <!-- ── COLUMNA DERECHA ── -->
                    <VBox minWidth="200" prefWidth="250" spacing="20">

                        <!-- Descripcion -->
                        <VBox prefHeight="196.0" prefWidth="250.0" spacing="6">
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="DESCRIPCION / INSTRUCCIONES" />
                            <TextArea fx:id="txtDescripcion" prefHeight="152.0" prefRowCount="6" prefWidth="250.0" promptText="Instrucciones tecnicas para la ejecucion correcta del ejercicio..." style="-fx-background-color: #0c0e11;                                              -fx-background-radius: 8;                                              -fx-border-color: rgba(255,255,255,0.1);                                              -fx-border-width: 1; -fx-border-radius: 8;                                              -fx-control-inner-background: #0c0e11;                                              -fx-font-family: 'Inter'; -fx-font-size: 14px;                                              -fx-text-fill: #e2e2e6; -fx-prompt-text-fill: #4b5563;" wrapText="true" VBox.vgrow="ALWAYS" />
                        </VBox>

                        <!-- URL Recurso / Video -->
                        <VBox spacing="6">
                            <Label style="-fx-font-family: 'Space Grotesk'; -fx-font-size: 11px;                                           -fx-font-weight: 700; -fx-text-fill: #6b7280;" text="URL DE RECURSO (VIDEO / TUTORIAL)" />
                            <TextField fx:id="txtRecursoUrl" promptText="https://youtube.com/..." style="-fx-background-color: #0c0e11;                                               -fx-border-color: rgba(255,255,255,0.1);                                               -fx-border-width: 1; -fx-border-radius: 8;                                               -fx-background-radius: 8;                                               -fx-font-family: 'Inter'; -fx-font-size: 14px;                                               -fx-text-fill: #e2e2e6; -fx-prompt-text-fill: #4b5563;                                               -fx-padding: 12 14 12 14;" />
                        </VBox>

                    </VBox>

                </HBox>

                <!-- ── SECCION METRICAS ── -->
                <VBox spacing="12">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <ImageView fitHeight="22" fitWidth="22" preserveRatio="true">
                            <image><Image url="@../images/add_circle.png" /></image>
                        </ImageView>
                    </HBox>

                </VBox>

            </VBox>
        </ScrollPane>

        <!-- ── FOOTER — idéntico a NuevaRutina ── -->
        <HBox alignment="CENTER_LEFT" prefHeight="60" style="-fx-background-color: #1a1c1f;                      -fx-background-radius: 0 0 12 12;                      -fx-border-color: rgba(255,255,255,0.05);                      -fx-border-width: 1 0 0 0;">
            <padding><Insets left="24" right="24" /></padding>

            <!-- Barra de progreso inferior — igual que NuevaRutina -->
            <Region fx:id="progressBar" prefHeight="2" prefWidth="0" style="-fx-background-color: #D4FF00; -fx-background-radius: 0 0 0 12;" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="16">
                <Button fx:id="btnCancelar" onAction="#handleCerrar" style="-fx-background-color: transparent; -fx-background-radius: 8;                                -fx-font-family: 'Space Grotesk'; -fx-font-size: 11px; -fx-font-weight: 700;                                -fx-text-fill: #e2e2e6; -fx-cursor: hand; -fx-padding: 10 20 10 20;" text="CANCELAR" />

                <Button fx:id="btnGuardar" onAction="#handleGuardar" style="-fx-background-color: #1e2a00; -fx-background-radius: 8; -fx-font-family: 'Space Grotesk'; -fx-font-size: 12px; -fx-font-weight: 700; -fx-text-fill: #D4FF00; -fx-border-color: #D4FF00; -fx-border-width: 2; -fx-border-radius: 8; -fx-cursor: hand; -fx-padding: 12 32 12 32;">
                    <graphic>
                        <ImageView fitHeight="18" fitWidth="18" preserveRatio="true">
                            <image><Image url="@../images/guardar.png" /></image>
                        </ImageView>
                    </graphic>
                    GUARDAR EJERCICIO
                </Button>
            </HBox>
        </HBox>

    </VBox>
</StackPane>
