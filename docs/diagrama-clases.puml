    + actualizar(r: Rutina): boolean
    + desactivar(id: int): boolean
    + asignarEjercicios(idRutina: int, ejercicios: List): void
  }

  class ProgresoService {
    + registrarProgreso(p: Progreso): int
    + listarPorCliente(idCliente: int): List
