@startuml
title GYMBROT - Diagrama de Clases (Arquitectura Completa)

package org.gymbrot.model {
  class Usuario {
    - numeroIdentificacion: String
    - tipoIdentificacion: String
    - nombre: String
    - apellidos: String
    - correo: String
    - telefono: String
    - contrasenaHash: String
    - fotoUrl: String
    - estado: String
    - fechaRegistro: Date
    - tipoUsuario: String
  }

  class Cliente {
    - direccion: String
    - fechaNacimiento: Date
    - huellaDactilar: byte[]
  }

  class Instructor {
    - idEspecialidad: int
    - disponibilidad: String
    - fechaContratacion: Date
  }

  class Administrador {
    - rol: String
  }

  class Especialidad {
    - idEspecialidad: int
    - nombre: String
    - descripcion: String
  }

  class Membresia {
    - idMembresia: int
    - idPlan: int
    - tipoMembresia: String
    - modalidadPago: String
    - valor: double
    - fechaInicio: Date
    - fechaVencimiento: Date
    - estado: String
  }

  class PlanMembresia {
    - idPlan: int
    - nombre: String
    - descripcion: String
    - precioMensual: double
    - precioSemestral: double
    - precioAnual: double
    - beneficios: String
    - duracionDias: int
  }

  class HistorialMembresia {
    - idHistorial: int
    - idCliente: int
    - idMembresia: int
    - fechaAsignacion: Date
    - activa: boolean
  }

  class Pago {
    - idPago: int
    - idMembresia: int
    - idCliente: int
    - fechaPago: Date
    - valor: double
    - metodoPago: String
    - estadoPago: String
    - referenciaTransaccion: String
    - observaciones: String
  }

  class Cita {
    - idCita: int
    - idCliente: int
    - idInstructor: int
    - fecha: Date
    - hora: String
    - tipoCita: String
    - estado: String
    - notas: String
  }

  class Ejercicio {
    - idEjercicio: int
    - nombre: String
    - descripcion: String
    - grupoMuscular: String
    - nivel: String
    - series: int
    - repeticiones: int
    - recursoUrl: String
  }

  class Rutina {
    - idRutina: int
    - nombre: String
    - descripcion: String
    - objetivo: String
    - idInstructor: int
    - idCliente: int
    - fechaCreacion: Date
    - fechaFin: Date
    - diasSemana: String
  }

  class RutinaEjercicio {
    - idRutina: int
    - idEjercicio: int
    - orden: int
    - series: int
    - repeticiones: int
    - descanso: int
    - notasInstructor: String
  }

  class Progreso {
    - idProgreso: int
    - idCliente: int
    - fechaRegistro: Date
    - peso: double
    - altura: double
    - imc: double
    - porcentajeGrasa: double
    - masaMuscular: double
    - objetivo: String
  }

  class RegistroIngreso {
    - idIngreso: int
    - idCliente: int
    - fecha: Date
    - horaEntrada: String
    - horaSalida: String
    - metodoVerificacion: String
    - estadoVerificacion: String
  }

  class Notificacion {
    - idNotificacion: int
    - idCliente: int
    - tipo: String
    - mensaje: String
    - fechaEnvio: Date
    - leida: boolean
  }

  class PlantillaMensaje {
    - idPlantilla: int
    - codigo: String
    - asunto: String
    - cuerpo: String
    - variables: String
  }

  class SesionGymbrot {
    - idSesion: int
    - idCliente: int
    - fechaInicio: Date
    - fechaFin: Date
    - activa: boolean
  }

  class MensajeGymbrot {
    - idMensaje: int
    - idSesion: int
    - remitente: String
    - contenido: String
    - fechaEnvio: Date
  }

  Usuario <|-- Cliente
  Usuario <|-- Instructor
  Usuario <|-- Administrador

  Cliente "1" -- "0..*" Membresia : posee
  Cliente "1" -- "0..*" HistorialMembresia : tiene
  Cliente "1" -- "0..*" Pago : realiza
  Cliente "1" -- "0..*" Cita : agenda
  Cliente "1" -- "0..*" Rutina : asigna
  Cliente "1" -- "0..*" RegistroIngreso : registra
  Cliente "1" -- "0..*" Progreso : registra
  Cliente "1" -- "0..*" Notificacion : recibe
  Cliente "1" -- "0..*" SesionGymbrot : inicia

  Instructor "0..1" -- "0..*" Cita : atiende
  Instructor "0..1" -- "0..*" Rutina : crea
  Instructor "0..1" -- "1" Especialidad : tiene

  Membresia "0..*" -- "1..*" PlanMembresia : pertenece
  Membresia "1" -- "0..*" HistorialMembresia : historial
  Membresia "1" -- "0..*" Pago : genera

  Rutina "1" -- "0..*" RutinaEjercicio : contiene
  Ejercicio "1" -- "0..*" RutinaEjercicio : incluido

  SesionGymbrot "1" -- "0..*" MensajeGymbrot : contiene
}

package org.gymbrot.dao {
  class UsuarioDAO {
    + insertar(u: Usuario): int
    + buscarPorId(id: int): Usuario
    + buscarPorNombreOCorreo(termino: String): List
    + listarTodos(): List
    + actualizar(u: Usuario): boolean
    + desactivar(id: int): boolean
  }

  class ClienteDAO {
    + insertar(c: Cliente): int
    + buscarPorId(id: int): Cliente
    + listarTodos(): List
    + actualizar(c: Cliente): boolean
    + desactivar(id: int): boolean
    + registrarClienteProc(c: Cliente): int
  }

  class InstructorDAO {
    + insertar(i: Instructor): int
    + buscarPorId(id: int): Instructor
    + listarTodos(): List
    + listarDisponibles(): List
    + actualizar(i: Instructor): boolean
    + desactivar(id: int): boolean
  }

  class AdministradorDAO {
    + insertar(a: Administrador): int
    + buscarPorId(id: int): Administrador
    + listarTodos(): List
    + actualizar(a: Administrador): boolean
  }

  class EspecialidadDAO {
    + insertar(e: Especialidad): int
    + buscarPorId(id: int): Especialidad
    + listarTodas(): List
    + actualizar(e: Especialidad): boolean
  }

  class MembresiaDAO {
    + insertar(m: Membresia): int
    + buscarPorId(id: int): Membresia
    + listarTodas(): List
    + listarPorCliente(idCliente: int): List
    + insertarYRetornarId(m: Membresia): int
    + actualizar(m: Membresia): boolean
    + desactivar(id: int): boolean
  }

  class PlanMembresiaDAO {
    + insertar(p: PlanMembresia): int
    + buscarPorId(id: int): PlanMembresia
    + listarTodos(): List
    + actualizar(p: PlanMembresia): boolean
  }

  class HistorialMembresiaDAO {
    + insertar(h: HistorialMembresia): int
    + buscarActiva(idCliente: int): HistorialMembresia
    + listarPorCliente(idCliente: int): List
    + desactivarPorCliente(idCliente: int): void
  }

  class PagoDAO {
    + insertar(p: Pago): int
    + listarPorCliente(idCliente: int): List
    + listarTodos(): List
    + listarTodosConCliente(): List
  }

  class CitaDAO {
    + insertar(c: Cita): int
    + insertarYRetornarId(c: Cita): int
    + buscarPorId(id: int): Cita
    + listarTodas(): List
    + listarPorFecha(fecha: Date): List
    + listarPorInstructor(idInstructor: int): List
    + listarPorCliente(idCliente: int): List
    + actualizar(c: Cita): boolean
  }

  class EjercicioDAO {
    + insertar(e: Ejercicio): int
    + buscarPorId(id: int): Ejercicio
    + listarTodos(): List
    + actualizar(e: Ejercicio): boolean
    + desactivar(id: int): boolean
  }

  class RutinaDAO {
    + insertar(r: Rutina): int
    + buscarPorId(id: int): Rutina
    + listarTodas(): List
    + buscarPorInstructor(idInstructor: int): List
    + actualizar(r: Rutina): boolean
    + desactivar(id: int): boolean
  }

  class RutinaEjercicioDAO {
    + insertar(re: RutinaEjercicio): int
    + listarPorRutina(idRutina: int): List
    + eliminarPorRutina(idRutina: int): void
  }

  class ProgresoDAO {
    + insertar(p: Progreso): int
    + listarPorCliente(idCliente: int): List
    + desactivar(id: int): boolean
  }

  class RegistroIngresoDAO {
    + insertar(r: RegistroIngreso): int
    + registrarEntrada(r: RegistroIngreso): int
    + registrarSalidaPorCliente(idCliente: int): void
    + listarPorFecha(fecha: Date): List
    + listarPorCliente(idCliente: int): List
  }

  class NotificacionDAO {
    + insertar(n: Notificacion): int
    + listarNoLeidas(idCliente: int): List
    + marcarcomoLeida(idNotificacion: int): void
  }

  class PlantillaMensajeDAO {
    + insertar(p: PlantillaMensaje): int
    + buscarPorCodigo(codigo: String): PlantillaMensaje
    + listarTodas(): List
    + actualizar(p: PlantillaMensaje): boolean
  }

  class MensajeGymbrotDAO {
    + insertar(m: MensajeGymbrot): int
    + listarPorSesion(idSesion: int): List
  }

  class SesionGymbrotDAO {
    + insertar(s: SesionGymbrot): int
    + buscarActiva(idCliente: int): SesionGymbrot
    + cerrarSesion(idSesion: int): void
  }

  UsuarioDAO --> DatabaseConnection
